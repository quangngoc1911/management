frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.env
frontend/.env.local
frontend/.env.production

# ================================
# IDE
# ================================
.vs/
.vscode/
*.user
*.suo

# ================================
# Docker
# ================================
.dockerignore

# ================================
# OS
# ================================
.DS_Store
Thumbs.db
node_modules


technical_documents/



